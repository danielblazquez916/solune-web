{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solune-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
  },
  "routes": [],
  "env": {
    "development": {
      "name": "solune-contact-development",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173",
      },
    },
    "production": {
      "name": "solune-contact",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.solune.dev",
          "custom_domain": true,
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://solune.dev,https://www.solune.dev",
      },
    },
  },
}
