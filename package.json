{
  "name": "solune-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test:worker-runtime": "node tests/worker-runtime.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:worker-runtime",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check": "tsc --noEmit",
    "deploy:web": "npm run build && npm run check:secrets && wrangler deploy --env production",
    "preview:cloudflare": "wrangler dev --env production --ip 127.0.0.1 --port 8788",
    "dry-run:web": "npm run build && npm run check:secrets && wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "framer-motion": "^13.4.2",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "4.141.0"
  }
}
