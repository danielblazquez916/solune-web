{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solune-web",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "production": {
      "name": "solune-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "solune.dev",
          "custom_domain": true,
        },
        {
          "pattern": "www.solune.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
